@model IEnumerable<EmployeeManagementSystem.Models.LeaveRequest>
@{ ViewData["Title"] = "Leave Management"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0 fw-bold" style="color:#1e3a5f">Leave Management</h5>
        <small class="text-muted">@Model.Count() request(s)</small>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
        {
            <a asp-action="ExportExcel" class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel me-1"></i>Export</a>
        }
        <a asp-action="Apply" class="btn btn-primary btn-sm"><i class="bi bi-plus me-1"></i>Apply for Leave</a>
    </div>
</div>

<!-- Filter -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetNames<EmployeeManagementSystem.Models.LeaveStatus>())
                    {
                        <option value="@s" selected="@(ViewBag.StatusFilter == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary btn-sm">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Leave Type</th>
                        <th>Duration</th>
                        <th>Days</th>
                        <th>Status</th>
                        <th>Applied</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var l in Model.OrderByDescending(x => x.CreatedAt))
                {
                    var statusColor = l.Status.ToString().Contains("Approved") ? "success"
                        : l.Status == EmployeeManagementSystem.Models.LeaveStatus.Pending ? "warning"
                        : l.Status == EmployeeManagementSystem.Models.LeaveStatus.Cancelled ? "secondary" : "danger";
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar" style="width:30px;height:30px;font-size:12px">@(l.Employee?.FirstName?[0] ?? '?')</div>
                                <span class="small fw-semibold">@l.Employee?.FullName</span>
                            </div>
                        </td>
                        <td><span class="badge bg-primary-subtle text-primary small">@l.Employee?.Department?.Name</span></td>
                        <td><span class="badge bg-info-subtle text-info">@l.LeaveType</span></td>
                        <td class="small text-muted">@l.StartDate.ToString("dd MMM") – @l.EndDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge bg-secondary">@((l.EndDate - l.StartDate).Days + 1)d</span></td>
                        <td><span class="badge bg-@statusColor-subtle text-@statusColor status-badge">@l.Status</span></td>
                        <td class="small text-muted">@l.CreatedAt.ToString("dd MMM yy")</td>
                        <td>
                            <div class="d-flex gap-1">
                                @if ((User.IsInRole("Manager") || User.IsInRole("HR") || User.IsInRole("Admin")) && l.Status == EmployeeManagementSystem.Models.LeaveStatus.Pending)
                                {
                                    <a asp-action="Review" asp-route-id="@l.Id" class="btn btn-sm btn-outline-primary" style="font-size:11px">Review</a>
                                }
                                @if (l.Status == EmployeeManagementSystem.Models.LeaveStatus.Pending)
                                {
                                    <form asp-action="Cancel" asp-route-id="@l.Id" method="post" class="d-inline" onsubmit="return confirm('Cancel this leave request?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size:11px">Cancel</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
