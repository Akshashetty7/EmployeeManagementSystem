@model EmployeeManagementSystem.Models.LeaveRequest
@{ ViewData["Title"] = "Review Leave Request"; }

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="mb-0 fw-bold" style="color:#1e3a5f">Review Leave Request</h5>
</div>

<div class="row justify-content-start">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header p-3"><i class="bi bi-person me-2 text-primary"></i>Request Details</div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-light rounded">
                    <div class="avatar" style="width:50px;height:50px;font-size:1.4rem">@Model.Employee?.FirstName?[0]</div>
                    <div>
                        <div class="fw-bold">@Model.Employee?.FullName</div>
                        <div class="small text-muted">@Model.Employee?.JobTitle &bull; @Model.Employee?.Department?.Name</div>
                        <div class="small text-muted">@Model.Employee?.EmployeeCode</div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6"><div class="p-2 bg-light rounded"><small class="text-muted d-block">Leave Type</small><strong>@Model.LeaveType</strong></div></div>
                    <div class="col-6"><div class="p-2 bg-light rounded"><small class="text-muted d-block">Duration</small><strong>@((Model.EndDate - Model.StartDate).Days + 1) day(s)</strong></div></div>
                    <div class="col-6"><div class="p-2 bg-light rounded"><small class="text-muted d-block">Start Date</small><strong>@Model.StartDate.ToString("dd MMM yyyy")</strong></div></div>
                    <div class="col-6"><div class="p-2 bg-light rounded"><small class="text-muted d-block">End Date</small><strong>@Model.EndDate.ToString("dd MMM yyyy")</strong></div></div>
                    <div class="col-12"><div class="p-2 bg-light rounded"><small class="text-muted d-block">Reason</small><strong>@Model.Reason</strong></div></div>
                    <div class="col-6"><div class="p-2 bg-light rounded"><small class="text-muted d-block">Current Status</small>
                        @{ var sc = Model.Status.ToString().Contains("Approved") ? "success" : Model.Status == EmployeeManagementSystem.Models.LeaveStatus.Pending ? "warning" : "danger"; }
                        <span class="badge bg-@sc">@Model.Status</span></div>
                    </div>
                    <div class="col-6"><div class="p-2 bg-light rounded"><small class="text-muted d-block">Applied On</small><strong>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</strong></div></div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ManagerRemarks))
                {
                    <div class="alert alert-info mt-3 py-2 small">
                        <strong>Manager Remarks:</strong> @Model.ManagerRemarks
                        <div class="text-muted mt-1">Reviewed: @Model.ManagerReviewDate?.ToString("dd MMM yyyy")</div>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header p-3"><i class="bi bi-check2-circle me-2 text-success"></i>Your Decision</div>
            <div class="card-body">
                <form asp-action="Review" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Remarks</label>
                        <textarea name="remarks" class="form-control form-control-sm" rows="3" placeholder="Add your comments or reason..."></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" name="action" value="approve" class="btn btn-success flex-fill">
                            <i class="bi bi-check-circle me-2"></i>Approve
                        </button>
                        <button type="submit" name="action" value="reject" class="btn btn-danger flex-fill" onclick="return confirm('Reject this leave request?')">
                            <i class="bi bi-x-circle me-2"></i>Reject
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
