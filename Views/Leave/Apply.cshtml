@model EmployeeManagementSystem.Models.LeaveRequest
@{ ViewData["Title"] = "Apply for Leave"; }

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="mb-0 fw-bold" style="color:#1e3a5f">Apply for Leave</h5>
</div>

<div class="row justify-content-start">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header p-3"><i class="bi bi-calendar-plus me-2 text-primary"></i>Leave Request Form</div>
            <div class="card-body">
                <form asp-action="Apply" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

                    @if ((bool)(ViewBag.IsHRorAdmin ?? false))
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Employee</label>
                            <select name="EmployeeId" class="form-select form-select-sm" required>
                                <option value="">Select Employee</option>
                                @foreach (var e in (List<EmployeeManagementSystem.Models.Employee>)ViewBag.Employees)
                                {
                                    <option value="@e.Id">@e.FullName (@e.EmployeeCode)</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="EmployeeId" value="@ViewBag.Employee?.Id" />
                        <div class="alert alert-info py-2 small">
                            <i class="bi bi-person me-1"></i>Applying as: <strong>@ViewBag.Employee?.FullName</strong>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="LeaveType" class="form-label small fw-semibold"></label>
                        <select asp-for="LeaveType" asp-items="Html.GetEnumSelectList<EmployeeManagementSystem.Models.LeaveType>()" class="form-select form-select-sm"></select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="StartDate" class="form-label small fw-semibold"></label>
                            <input asp-for="StartDate" type="date" class="form-control form-control-sm" id="startDate" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="EndDate" class="form-label small fw-semibold"></label>
                            <input asp-for="EndDate" type="date" class="form-control form-control-sm" id="endDate" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-light border py-2 small mb-3" id="dayCount" style="display:none">
                        <i class="bi bi-calendar me-1"></i>Duration: <strong id="dayCountVal">0</strong> day(s)
                    </div>

                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label small fw-semibold"></label>
                        <textarea asp-for="Reason" class="form-control form-control-sm" rows="3" placeholder="Briefly describe the reason for leave..."></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send me-2"></i>Submit Request</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header p-3"><i class="bi bi-info-circle me-2 text-primary"></i>Leave Policy</div>
            <div class="card-body">
                <div class="row g-2">
                    @foreach (var (type, days) in new[] { ("Annual", 18), ("Sick", 12), ("Maternity", 90), ("Paternity", 15), ("Compassionate", 5) })
                    {
                        <div class="col-6">
                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded">
                                <span class="small">@type</span>
                                <span class="badge bg-primary">@days days/yr</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    function calcDays() {
        const s = new Date(document.getElementById('startDate').value);
        const e = new Date(document.getElementById('endDate').value);
        if (s && e && e >= s) {
            const d = Math.round((e - s) / 86400000) + 1;
            document.getElementById('dayCountVal').textContent = d;
            document.getElementById('dayCount').style.display = '';
        }
    }
    document.getElementById('startDate').addEventListener('change', calcDays);
    document.getElementById('endDate').addEventListener('change', calcDays);
    </script>
}
