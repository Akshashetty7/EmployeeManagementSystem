@model IEnumerable<EmployeeManagementSystem.Models.Department>
@{ ViewData["Title"] = "Departments"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold" style="color:#1e3a5f">Departments</h5>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus me-1"></i>New Department</a>
</div>

<div class="row g-3">
@foreach (var d in Model)
{
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h6 class="fw-bold mb-0">@d.Name</h6>
                        <small class="text-muted">@d.Location</small>
                    </div>
                    <span class="badge @(d.IsActive ? "bg-success" : "bg-secondary")">@(d.IsActive ? "Active" : "Inactive")</span>
                </div>
                <p class="text-muted small mb-3">@d.Description</p>
                <div class="d-flex gap-3 mb-2">
                    <div class="text-center">
                        <div class="fw-bold fs-5 text-primary">@d.Employees.Count</div>
                        <div class="text-muted" style="font-size:11px">Employees</div>
                    </div>
                    <div class="text-center">
                        <div class="fw-bold fs-5 text-success">₹@((d.Employees.Any() ? d.Employees.Average(e => e.BaseSalary) : 0).ToString("N0"))</div>
                        <div class="text-muted" style="font-size:11px">Avg Salary</div>
                    </div>
                </div>
                @if (d.Manager != null)
                {
                    <div class="d-flex align-items-center gap-2 p-2 bg-light rounded">
                        <div class="avatar" style="width:26px;height:26px;font-size:11px">@d.Manager.FirstName[0]</div>
                        <div style="font-size:12px"><strong>Head:</strong> @d.Manager.FullName</div>
                    </div>
                }
            </div>
            <div class="card-footer bg-transparent py-2">
                <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <a asp-controller="Employees" asp-action="Index" asp-route-deptId="@d.Id" class="btn btn-sm btn-outline-secondary ms-1">
                    <i class="bi bi-people me-1"></i>View Employees
                </a>
            </div>
        </div>
    </div>
}
</div>
