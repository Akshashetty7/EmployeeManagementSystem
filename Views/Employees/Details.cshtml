@model EmployeeManagementSystem.Models.Employee
@{ ViewData["Title"] = Model.FullName; }

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="mb-0 fw-bold" style="color:#1e3a5f">Employee Profile</h5>
    <div class="ms-auto d-flex gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Manager"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
        }
    </div>
</div>

<div class="row g-3">
    <!-- Profile Header -->
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-4">
                    <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#1e3a5f,#2e86de);display:flex;align-items:center;justify-content:center;color:#fff;font-size:2rem;font-weight:800">
                        @Model.FirstName[0]
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="fw-bold mb-1">@Model.FullName</h4>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="badge bg-primary">@Model.JobTitle</span>
                            <span class="badge bg-secondary">@Model.Department?.Name</span>
                            @{
                                var sc = Model.Status switch {
                                    EmployeeManagementSystem.Models.EmploymentStatus.Active => "success",
                                    EmployeeManagementSystem.Models.EmploymentStatus.OnLeave => "warning",
                                    _ => "danger"
                                };
                            }
                            <span class="badge bg-@sc">@Model.Status</span>
                            <span class="text-muted small"><i class="bi bi-hash"></i>@Model.EmployeeCode</span>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold fs-5 text-success">₹@(Model.BaseSalary.ToString("N0"))<small class="text-muted fw-normal fs-6">/mo</small></div>
                        <div class="text-muted small">Since @Model.JoinDate.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Columns -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header p-3"><i class="bi bi-person me-2 text-primary"></i>Personal Details</div>
            <div class="card-body">
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Email</span><span class="small fw-semibold">@Model.Email</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Phone</span><span class="small fw-semibold">@(Model.Phone ?? "—")</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Gender</span><span class="small fw-semibold">@Model.Gender</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Date of Birth</span><span class="small fw-semibold">@Model.DateOfBirth.ToString("dd MMM yyyy") (Age @Model.Age)</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Address</span><span class="small fw-semibold">@Model.Address, @Model.City @Model.PostalCode</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">National ID</span><span class="small fw-semibold">@(Model.NationalId ?? "—")</span></div>
                <div class="d-flex justify-content-between py-2"><span class="text-muted small">Emergency Contact</span><span class="small fw-semibold">@(Model.EmergencyContact ?? "—")</span></div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header p-3"><i class="bi bi-briefcase me-2 text-primary"></i>Employment Details</div>
            <div class="card-body">
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Employee Code</span><span class="badge bg-light text-dark border">@Model.EmployeeCode</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Department</span><span class="badge bg-primary-subtle text-primary">@Model.Department?.Name</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Job Title</span><span class="small fw-semibold">@Model.JobTitle</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Reports To</span><span class="small fw-semibold">@(Model.ReportsTo?.FullName ?? "—")</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Join Date</span><span class="small fw-semibold">@Model.JoinDate.ToString("dd MMM yyyy")</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Tenure</span><span class="small fw-semibold">@((int)((DateTime.Today - Model.JoinDate).TotalDays / 365)) yr(s) @((int)(((DateTime.Today - Model.JoinDate).TotalDays % 365) / 30)) mo(s)</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Salary</span><span class="small fw-semibold text-success">₹@(Model.BaseSalary.ToString("N0"))/month</span></div>
                <div class="d-flex justify-content-between py-2"><span class="text-muted small">Direct Reports</span><span class="badge bg-info-subtle text-info">@Model.Subordinates.Count</span></div>
            </div>
        </div>
    </div>

    <!-- Recent Leave -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header p-3 d-flex justify-content-between">
                <span><i class="bi bi-calendar-check me-2 text-warning"></i>Recent Leave Requests</span>
                <a asp-controller="Leave" asp-action="Index" asp-route-empId="@Model.Id" class="btn btn-sm btn-outline-primary" style="font-size:11px">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.LeaveRequests.Any())
                {
                    <p class="text-muted text-center py-3 mb-0 small">No leave history</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                    @foreach (var l in Model.LeaveRequests)
                    {
                        var lc = l.Status.ToString().Contains("Approved") ? "success" : l.Status == EmployeeManagementSystem.Models.LeaveStatus.Pending ? "warning" : "danger";
                        <div class="list-group-item py-2 px-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="small fw-semibold">@l.LeaveType</span>
                                    <span class="text-muted small ms-2">@l.StartDate.ToString("dd MMM") – @l.EndDate.ToString("dd MMM yyyy")</span>
                                </div>
                                <span class="badge bg-@lc">@l.Status</span>
                            </div>
                        </div>
                    }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Audit Log -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header p-3"><i class="bi bi-clock-history me-2 text-secondary"></i>Audit Trail</div>
            <div class="card-body p-0">
                @if (!Model.AuditLogs.Any())
                {
                    <p class="text-muted text-center py-3 mb-0 small">No audit records</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                    @foreach (var a in Model.AuditLogs)
                    {
                        <div class="list-group-item py-2 px-3">
                            <div class="d-flex justify-content-between">
                                <span class="small"><span class="badge bg-secondary me-1">@a.Action</span>by @a.PerformedByName</span>
                                <span class="text-muted" style="font-size:11px">@a.Timestamp.ToString("dd MMM yy HH:mm")</span>
                            </div>
                        </div>
                    }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
