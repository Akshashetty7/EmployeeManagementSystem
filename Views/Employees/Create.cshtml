@model EmployeeManagementSystem.Models.ViewModels.EmployeeViewModel
@{ ViewData["Title"] = "Add Employee"; }

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="mb-0 fw-bold" style="color:#1e3a5f">Add New Employee</h5>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <!-- Personal Info -->
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header p-3"><i class="bi bi-person me-2 text-primary"></i>Personal Information</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="EmployeeCode" class="form-label small fw-semibold"></label>
                            <input asp-for="EmployeeCode" class="form-control form-control-sm" placeholder="EMP026" />
                            <span asp-validation-for="EmployeeCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="FirstName" class="form-label small fw-semibold"></label>
                            <input asp-for="FirstName" class="form-control form-control-sm" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="LastName" class="form-label small fw-semibold"></label>
                            <input asp-for="LastName" class="form-control form-control-sm" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold"></label>
                            <input asp-for="Email" class="form-control form-control-sm" placeholder="name@nexacorp.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold"></label>
                            <input asp-for="Phone" class="form-control form-control-sm" placeholder="9876543XXX" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label small fw-semibold"></label>
                            <select asp-for="Gender" asp-items="Html.GetEnumSelectList<EmployeeManagementSystem.Models.Gender>()" class="form-select form-select-sm"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label small fw-semibold"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control form-control-sm" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NationalId" class="form-label small fw-semibold"></label>
                            <input asp-for="NationalId" class="form-control form-control-sm" placeholder="PAN / Aadhar ref" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label small fw-semibold"></label>
                            <input asp-for="Address" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label small fw-semibold"></label>
                            <input asp-for="City" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PostalCode" class="form-label small fw-semibold"></label>
                            <input asp-for="PostalCode" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-9">
                            <label asp-for="EmergencyContact" class="form-label small fw-semibold"></label>
                            <input asp-for="EmergencyContact" class="form-control form-control-sm" placeholder="Name: phone number" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Employment Info -->
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header p-3"><i class="bi bi-briefcase me-2 text-primary"></i>Employment Details</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="JobTitle" class="form-label small fw-semibold"></label>
                            <input asp-for="JobTitle" class="form-control form-control-sm" />
                            <span asp-validation-for="JobTitle" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="DepartmentId" class="form-label small fw-semibold"></label>
                            <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select form-select-sm">
                                <option value="">Select Department</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ReportsToId" class="form-label small fw-semibold"></label>
                            <select asp-for="ReportsToId" asp-items="Model.Managers" class="form-select form-select-sm">
                                <option value="">None (Top-level)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="JoinDate" class="form-label small fw-semibold"></label>
                            <input asp-for="JoinDate" type="date" class="form-control form-control-sm" />
                            <span asp-validation-for="JoinDate" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="BaseSalary" class="form-label small fw-semibold"></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">₹</span>
                                <input asp-for="BaseSalary" class="form-control" type="number" min="0" step="1000" />
                            </div>
                            <span asp-validation-for="BaseSalary" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Status" class="form-label small fw-semibold"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<EmployeeManagementSystem.Models.EmploymentStatus>()" class="form-select form-select-sm"></select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-person-check me-2"></i>Save Employee</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
