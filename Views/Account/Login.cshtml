@model EmployeeManagementSystem.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EMS — Sign In</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            background: #fff;
        }

        /* ── LEFT ── */
        .left {
            flex: 1;
            background: #0d1b2a;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 2.8rem 3rem;
            position: relative;
            overflow: hidden;
        }

        /* Subtle dot grid */
        .left::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
            background-size: 28px 28px;
            pointer-events: none;
        }

        /* Glow blobs */
        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
        }
        .blob-1 { width: 380px; height: 380px; background: rgba(46,134,222,0.14); top: -100px; right: -60px; }
        .blob-2 { width: 260px; height: 260px; background: rgba(99,102,241,0.10); bottom: 40px; left: -60px; }

        .left-inner { position: relative; z-index: 1; }

        /* Brand */
        .brand { display: flex; align-items: center; gap: 11px; }
        .brand-icon {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, #2e86de, #6366f1);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; color: #fff;
        }
        .brand-name { font-size: 1.25rem; font-weight: 700; color: #fff; letter-spacing: 2px; }

        /* Hero text */
        .hero { margin-top: 5rem; }
        .hero-title {
            font-size: clamp(2rem, 3.2vw, 3rem);
            font-weight: 800;
            color: #fff;
            line-height: 1.18;
            letter-spacing: -0.5px;
        }
        .hero-title em {
            font-style: normal;
            background: linear-gradient(90deg, #60a5fa, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-sub {
            margin-top: 1rem;
            color: rgba(255,255,255,0.38);
            font-size: 0.95rem;
            line-height: 1.65;
            max-width: 360px;
        }

        .left-footer { color: rgba(255,255,255,0.18); font-size: 12px; }

        /* ── RIGHT ── */
        .right {
            width: 460px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem;
            background: #fff;
        }

        .form-box { width: 100%; max-width: 340px; }

        .form-head { margin-bottom: 2.2rem; }
        .form-head h2 { font-size: 1.55rem; font-weight: 800; color: #0d1117; margin-bottom: 5px; }
        .form-head p  { color: #6b7280; font-size: 13.5px; }

        .field { margin-bottom: 1.1rem; }
        .field label { display: block; font-size: 12.5px; font-weight: 600; color: #374151; margin-bottom: 6px; }

        .input-wrap { position: relative; }
        .input-wrap i.icon {
            position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
            color: #c4c9d4; font-size: 14px; pointer-events: none;
        }
        .input-wrap input {
            width: 100%;
            padding: 10px 38px 10px 38px;
            border: 1.5px solid #e5e7eb;
            border-radius: 9px;
            font-size: 13.5px;
            color: #111827;
            background: #fafafa;
            transition: border-color .18s, box-shadow .18s;
            outline: none;
        }
        .input-wrap input:focus {
            border-color: #2e86de;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(46,134,222,0.10);
        }
        .input-wrap input::placeholder { color: #c4c9d4; }
        .toggle-eye {
            position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: #c4c9d4; cursor: pointer;
            font-size: 15px; padding: 0; line-height: 1;
        }
        .toggle-eye:hover { color: #6b7280; }

        .check-row {
            display: flex; align-items: center; gap: 8px;
            margin-bottom: 1.5rem;
        }
        .check-row input[type=checkbox] { width: 14px; height: 14px; accent-color: #2e86de; cursor: pointer; }
        .check-row label { font-size: 13px; color: #374151; cursor: pointer; }

        .error-msg {
            background: #fef2f2;
            border-left: 3px solid #f87171;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 13px;
            color: #b91c1c;
            margin-bottom: 1.2rem;
            display: flex;
            gap: 8px;
            align-items: flex-start;
        }

        .btn-sign {
            width: 100%;
            padding: 11px;
            background: #0d1b2a;
            border: none;
            border-radius: 9px;
            color: #fff;
            font-size: 14.5px;
            font-weight: 600;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            transition: background .2s, transform .15s, box-shadow .2s;
            letter-spacing: .2px;
        }
        .btn-sign:hover {
            background: #2e86de;
            box-shadow: 0 4px 18px rgba(46,134,222,0.30);
            transform: translateY(-1px);
        }
        .btn-sign:active { transform: translateY(0); }

        .form-foot {
            margin-top: 2.2rem;
            padding-top: 1.4rem;
            border-top: 1px solid #f3f4f6;
            text-align: center;
            color: #9ca3af;
            font-size: 12px;
            line-height: 1.6;
        }

        @@media (max-width: 820px) {
            .left { display: none; }
            .right { width: 100%; }
        }
    </style>
</head>
<body>

    <div class="left">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>

        <div class="left-inner brand">
            <div class="brand-icon"><i class="bi bi-building-check"></i></div>
            <span class="brand-name">EMS</span>
        </div>

        <div class="left-inner hero">
            <h1 class="hero-title">Your workforce,<br /><em>fully in control.</em></h1>
            <p class="hero-sub">
                Manage employees, track leave, handle approvals, and keep every record audit-ready — from one secure place.
            </p>
        </div>

        <div class="left-inner left-footer">
            &copy; 2025 Employee Management System
        </div>
    </div>

    <div class="right">
        <div class="form-box">
            <div class="form-head">
                <h2>Welcome back</h2>
                <p>Sign in with your work credentials</p>
            </div>

            <form asp-action="Login" method="post" autocomplete="on" novalidate>
                <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="error-msg">
                        <i class="bi bi-exclamation-circle-fill" style="flex-shrink:0;margin-top:1px"></i>
                        <div>
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <div class="field">
                    <label for="Email">Work Email</label>
                    <div class="input-wrap">
                        <i class="bi bi-envelope icon"></i>
                        <input asp-for="Email" id="Email"
                               placeholder="you@company.com"
                               autocomplete="username"
                               spellcheck="false" />
                    </div>
                </div>

                <div class="field">
                    <label for="Password">Password</label>
                    <div class="input-wrap">
                        <i class="bi bi-lock icon"></i>
                        <input asp-for="Password" id="Password"
                               type="password"
                               placeholder="••••••••"
                               autocomplete="current-password" />
                        <button type="button" class="toggle-eye" onclick="togglePwd()" title="Show / hide">
                            <i class="bi bi-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="check-row">
                    <input asp-for="RememberMe" id="RememberMe" type="checkbox" />
                    <label for="RememberMe">Keep me signed in</label>
                </div>

                <button type="submit" class="btn-sign">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </button>
            </form>

            <div class="form-foot">
                Don't have access?<br />
                Contact your system administrator.
            </div>
        </div>
    </div>

    <script>
        function togglePwd() {
            const f = document.getElementById('Password');
            const i = document.getElementById('eyeIcon');
            f.type = f.type === 'password' ? 'text' : 'password';
            i.className = f.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        }
    </script>
</body>
</html>
