@model EmployeeManagementSystem.Models.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#1e3a5f,#2e86de)">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:2rem;font-weight:800">@Model.TotalEmployees</div>
                    <div style="font-size:13px;opacity:.85">Total Employees</div>
                </div>
                <i class="bi bi-people" style="font-size:2rem;opacity:.4"></i>
            </div>
            <div class="mt-2" style="font-size:12px;opacity:.7">@Model.ActiveEmployees active &middot; @Model.OnLeaveEmployees on leave</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#0f9d58,#34c472)">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:2rem;font-weight:800">@Model.TotalDepartments</div>
                    <div style="font-size:13px;opacity:.85">Departments</div>
                </div>
                <i class="bi bi-diagram-3" style="font-size:2rem;opacity:.4"></i>
            </div>
            <div class="mt-2" style="font-size:12px;opacity:.7">@Model.NewHiresThisMonth new hire(s) this month</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#e67e22,#f39c12)">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:2rem;font-weight:800">@Model.PendingLeaveRequests</div>
                    <div style="font-size:13px;opacity:.85">Pending Approvals</div>
                </div>
                <i class="bi bi-clock-history" style="font-size:2rem;opacity:.4"></i>
            </div>
            <div class="mt-2" style="font-size:12px;opacity:.7">Leave requests awaiting action</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#6f42c1,#a855f7)">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-size:2rem;font-weight:800">₹@((Model.TotalPayroll / 100000).ToString("F1"))L</div>
                    <div style="font-size:13px;opacity:.85">Monthly Payroll</div>
                </div>
                <i class="bi bi-currency-rupee" style="font-size:2rem;opacity:.4"></i>
            </div>
            <div class="mt-2" style="font-size:12px;opacity:.7">Total active headcount payroll</div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header p-3 d-flex align-items-center justify-content-between">
                <span><i class="bi bi-bar-chart me-2 text-primary"></i>Headcount by Department</span>
            </div>
            <div class="card-body">
                <canvas id="deptChart" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header p-3">
                <span><i class="bi bi-pie-chart me-2 text-primary"></i>Leave Type Distribution</span>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="leaveChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Tables Row -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header p-3 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock me-2 text-warning"></i>Pending Leave Requests</span>
                <a asp-controller="Leave" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.PendingLeaves.Any())
                {
                    <div class="text-center py-4 text-muted"><i class="bi bi-check-circle fs-3"></i><p class="mt-2 mb-0">No pending requests</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead><tr><th>Employee</th><th>Type</th><th>Dates</th><th>Action</th></tr></thead>
                            <tbody>
                            @foreach (var l in Model.PendingLeaves)
                            {
                                <tr>
                                    <td class="small fw-semibold">@l.Employee?.FullName</td>
                                    <td><span class="badge bg-info-subtle text-info">@l.LeaveType</span></td>
                                    <td class="small text-muted">@l.StartDate.ToString("dd MMM") – @l.EndDate.ToString("dd MMM")</td>
                                    <td>
                                        <a asp-controller="Leave" asp-action="Review" asp-route-id="@l.Id" class="btn btn-xs btn-outline-primary" style="font-size:11px;padding:2px 8px">Review</a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header p-3 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-person-plus me-2 text-success"></i>Recent Hires</span>
                <a asp-controller="Employees" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Name</th><th>Title</th><th>Department</th><th>Joined</th></tr></thead>
                        <tbody>
                        @foreach (var e in Model.RecentEmployees)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar">@e.FirstName[0]</div>
                                        <div class="small fw-semibold">@e.FullName</div>
                                    </div>
                                </td>
                                <td class="small text-muted">@e.JobTitle</td>
                                <td><span class="badge bg-primary-subtle text-primary small">@e.Department?.Name</span></td>
                                <td class="small text-muted">@e.JoinDate.ToString("dd MMM yy")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Department Stats -->
<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card">
            <div class="card-header p-3"><i class="bi bi-table me-2 text-primary"></i>Department Summary</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Department</th><th>Headcount</th><th>Avg Salary</th><th>Share</th></tr></thead>
                        <tbody>
                        @foreach (var d in Model.DepartmentStats.OrderByDescending(x => x.Count))
                        {
                            var pct = Model.TotalEmployees > 0 ? (d.Count * 100.0 / Model.TotalEmployees) : 0;
                            <tr>
                                <td class="fw-semibold small">@d.Department</td>
                                <td><span class="badge bg-secondary">@d.Count</span></td>
                                <td class="small">₹@(d.AverageSalary.ToString("N0"))/mo</td>
                                <td style="width:200px">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:6px">
                                            <div class="progress-bar bg-primary" style="width:@pct%"></div>
                                        </div>
                                        <span class="small text-muted">@pct.ToString("F0")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const deptLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentStats.Select(d => d.Department)));
const deptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentStats.Select(d => d.Count)));
const leaveLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeaveTypeDistribution.Keys));
const leaveData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeaveTypeDistribution.Values));

new Chart(document.getElementById('deptChart'), {
    type: 'bar',
    data: {
        labels: deptLabels,
        datasets: [{ label: 'Employees', data: deptData, backgroundColor: '#2e86de', borderRadius: 6 }]
    },
    options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
});

new Chart(document.getElementById('leaveChart'), {
    type: 'doughnut',
    data: {
        labels: leaveLabels,
        datasets: [{ data: leaveData, backgroundColor: ['#2e86de','#0f9d58','#e67e22','#e74c3c','#9b59b6','#1abc9c'], borderWidth: 2 }]
    },
    options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
});
</script>
}
